<!-- Linux FIM / audit noise suppression, renumbered 100630+ .
     The original file reused 100611, 100612 and 100621, which the Windows ignore rules already
     use (duplicate rule IDs). Old -> new: 100613->100630, 100614->100631, 100615->100632, 100616->100633, 100611->100634, 100612->100635, 100617->100636, 100618->100637, 100619->100638, 100621->100639, 100622->100640, 100623->100641, 100624->100642, 100625->100643 -->

<!-- LINUX PATH IGNORE -->
<group name="syscheck,audit_ignore,">

  <!-- Ignore temp / partial download suffixes in FIM (sid 550/553/554) -->
  <rule id="100630" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file">\.tmp$|\.part$|\.crdownload$|\.swp$</field>
    <description>Ignore FIM alerts for common temporary and partial download files.</description>
  </rule>

  <!-- Ignore generic temp directories -->
  <rule id="100631" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file">^/tmp|^/var/tmp|^/dev/shm</field>
    <description>Ignore FIM alerts for activity in system temporary directories.</description>
  </rule>

  <!-- dpkg / apt transient files -->
  <rule id="100632" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file">\.dpkg-new$|\.dpkg-tmp$|\.dpkg-old$</field>
    <description>Ignore FIM alerts for temporary files created during package updates (dpkg/apt).</description>
  </rule>

  <!-- Frequently updated system cache / time files -->
  <rule id="100633" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file">^/etc/ld\.so\.cache$|^/etc/localtime$|^/etc/timezone$</field>
    <description>Ignore FIM alerts for frequently updated system-wide config/cache files.</description>
  </rule>

  <!-- Specific known-noise file -->
  <rule id="100634" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file">/etc/cups/subscriptions.conf</field>
    <description>Ignore FIM alerts for CUPS subscriptions.conf</description>
  </rule>

  <!-- Firefox MemoryPoller audit noise -->
  <rule id="100635" level="0">
    <if_group>audit_event</if_group>
    <field name="audit.command">^MemoryPoller$</field>
    <field name="audit.exe">firefox$</field>
    <description>Ignore Firefox MemoryPoller noise in Ubuntu</description>
  </rule>

  <!-- LibreOffice config / registry noise -->
  <rule id="100636" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file">^/etc/libreoffice/|^/usr/lib/libreoffice/</field>
    <description>Ignore FIM alerts for LibreOffice updates and registry changes.</description>
  </rule>

  <!-- Common binary updates that are noisy but benign -->
  <rule id="100637" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file">^/usr/bin/rsync|^/usr/bin/soffice|^/usr/bin/libreoffice|^/usr/bin/Xwayland|^/usr/bin/ubuntu-report</field>
    <description>Ignore FIM alerts for specific common binary updates.</description>
  </rule>

  <!-- Font configuration churn -->
  <rule id="100638" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file">^/etc/fonts/conf\.d/</field>
    <description>Ignore FIM alerts for system font configuration updates.</description>
  </rule>

  <!-- Extra dpkg/apt temp patterns, + .new -->
  <rule id="100639" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file">\.dpkg-new$|\.dpkg-tmp$|\.dpkg-old$|\.dpkg-dist$|\.new$</field>
    <description>Ignore temporary files created during apt/dpkg updates.</description>
  </rule>

  <!-- glibc / locale tools churn -->
  <rule id="100640" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file">^/usr/sbin/zic|^/usr/sbin/ldconfig|^/usr/sbin/iconvconfig|^/usr/bin/zdump|^/usr/bin/tzselect|^/usr/bin/localedef|^/usr/bin/locale|^/usr/bin/ldd</field>
    <description>Ignore FIM alerts for standard glibc and locale system updates.</description>
  </rule>

  <!-- Ubuntu desktop / driver helper binaries -->
  <rule id="100641" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file">^/usr/bin/yelp|^/usr/bin/gnome-help|^/usr/bin/ubuntu-|^/usr/bin/nvidia-|^/usr/bin/gpu-manager|^/usr/bin/Xwayland</field>
    <description>Ignore FIM alerts for Ubuntu desktop and driver helpers.</description>
  </rule>

  <!-- PAM common-* autogenerated snippets -->
  <rule id="100642" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file">^/etc/pam\.d/common-</field>
    <description>Ignore FIM alerts for automated PAM configuration updates.</description>
  </rule>

  <!-- LibreOffice registry-specific noise -->
  <rule id="100643" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file">^/etc/libreoffice/registry/|^/usr/lib/libreoffice/</field>
    <description>Ignore FIM alerts for LibreOffice registry changes.</description>
  </rule>

</group>
